# Get this from @BotFather on Telegram after running /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenGoesHere

# OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# OpenRouter model to use for replies (provider/model format)
OPENROUTER_MODEL=anthropic/claude-opus-5-5

# Public HTTPS base URL that Telegram will send updates to, e.g. an ngrok URL
# or your server's domain. Only needed if you run main.py in webhook mode.
# Example: https://your-domain.com  (do NOT include a trailing slash)
WEBHOOK_URL=

# Random secret string used to verify that incoming webhook requests are
# really from Telegram. Make up any long random string.
WEBHOOK_SECRET=change-this-to-a-random-secret

# How many past messages (user + assistant) to keep/send as conversation history
HISTORY_LIMIT=15

# Where to store the SQLite database file
DB_PATH=data.db

# Port for the FastAPI server
PORT=3065
